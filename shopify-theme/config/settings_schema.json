[
  {
    "name": "theme_info",
    "theme_name": "DJ Crate Library Theme",
    "theme_version": "1.0.0",
    "theme_author": "DJ Crate Library",
    "theme_documentation_url": "https://djcratelibrary.com",
    "theme_support_url": "https://djcratelibrary.com"
  },
  {
    "name": "General & Branding",
    "settings": [
      {
        "type": "text",
        "id": "store_name",
        "label": "Store Name",
        "default": "DJ Crate Library"
      },
      {
        "type": "text",
        "id": "store_tagline",
        "label": "Store Tagline",
        "default": "Digital DJ Music Collection"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image"
      }
    ]
  },
  {
    "name": "Product & Checkout Settings",
    "settings": [
      {
        "type": "product",
        "id": "featured_product",
        "label": "Select Featured Product (DJ Crate Library)",
        "info": "Link your $49 product here to enable automatic Shopify checkout and digital fulfillment."
      },
      {
        "type": "text",
        "id": "display_price",
        "label": "Display Price",
        "default": "$49"
      },
      {
        "type": "text",
        "id": "compare_price",
        "label": "Original Price (Strikethrough)",
        "default": "$399"
      },
      {
        "type": "select",
        "id": "primary_checkout_action",
        "label": "Primary Button Action",
        "options": [
          {
            "value": "shopify_checkout",
            "label": "Direct Shopify Checkout (Instant Buy)"
          },
          {
            "value": "shopify_cart",
            "label": "Add to Shopify Cart"
          },
          {
            "value": "whatsapp",
            "label": "Redirect to WhatsApp (Conversational Order)"
          }
        ],
        "default": "shopify_checkout"
      }
    ]
  },
  {
    "name": "WhatsApp Concierge Support",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_whatsapp_float",
        "label": "Show Floating WhatsApp Concierge Button",
        "default": true
      },
      {
        "type": "text",
        "id": "whatsapp_phone",
        "label": "WhatsApp Phone Number (with Country Code, no + or spaces)",
        "default": "1234567890",
        "info": "Example: 15551234567"
      },
      {
        "type": "text",
        "id": "whatsapp_default_message",
        "label": "WhatsApp Default Message",
        "default": "Hi! I want to order the DJ Crate Library 380GB for $49"
      }
    ]
  }
]
