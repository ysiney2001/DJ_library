<footer class="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>
      <div>
        <strong>{{ section.settings.brand_title | default: 'DJ Crate Library' }}</strong>
        <span>{{ section.settings.brand_subtitle | default: 'Digital DJ Music Collection' }}</span>
      </div>
    </div>
    <p class="footer-note">{{ section.settings.footer_note | default: 'Product images are for presentation purposes.<br>DJ software and hardware are not included.<br>© 2026 DJ Crate Library. All rights reserved.' }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_title",
      "label": "Brand Title",
      "default": "DJ Crate Library"
    },
    {
      "type": "text",
      "id": "brand_subtitle",
      "label": "Brand Subtitle",
      "default": "Digital DJ Music Collection"
    },
    {
      "type": "textarea",
      "id": "footer_note",
      "label": "Footer Note",
      "default": "Product images are for presentation purposes.<br>DJ software and hardware are not included.<br>© 2026 DJ Crate Library. All rights reserved."
    }
  ]
}
{% endschema %}
