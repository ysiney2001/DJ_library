<section class="pricing" id="pricing">
  <div class="pricing-inner">
    <p class="section-label">{{ section.settings.label | default: 'GET INSTANT ACCESS' }}</p>
    <h2>{{ section.settings.heading | default: 'One Purchase. Lifetime Library.' }}</h2>
    <div class="pricing-card">
      <div class="pricing-badge">{{ section.settings.badge | default: '🔥 LIMITED TIME OFFER' }}</div>
      <p class="pricing-subtitle">{{ section.settings.subtitle | default: 'DJ Crate Library — 380GB Complete Pack' }}</p>
      
      {% assign prod = all_products[settings.featured_product] %}
      <div class="pricing-value">
        <span class="price-was">
          {% if prod != blank and prod.compare_at_price > prod.price %}
            {{ prod.compare_at_price | money_without_trailing_zeros }}
          {% else %}
            {{ settings.compare_price | default: '$399' }}
          {% endif %}
        </span>
        <div class="price-now">
          {% if prod != blank %}
            {{ prod.price | money_without_trailing_zeros }}
          {% else %}
            <span class="price-currency">$</span>49
          {% endif %}
        </div>
        <span class="price-period">One-time payment · No subscriptions</span>
      </div>

      <div class="pricing-savings">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        <span>You save $350 (88% OFF)</span>
      </div>

      <ul class="pricing-features">
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span>380GB+ of curated music</span>
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span>1970s through late 2024</span>
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span>15+ genres organized in folders</span>
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span>320kbps MP3 — club-ready quality</span>
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span>Intros, outros, remixes & radio edits</span>
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span>Optional Serato database crates</span>
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span>Works with Serato, Rekordbox, Traktor, Virtual DJ</span>
        </li>
      </ul>

      {% if settings.primary_checkout_action == 'shopify_checkout' and prod != blank %}
        <a href="/cart/{{ prod.selected_or_first_available_variant.id }}:1?checkout" class="btn-whatsapp btn-lg" id="pricing-order-btn">
          <svg class="wa-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          {{ section.settings.button_text | default: 'Buy Now — $49' }}
        </a>
      {% elsif settings.primary_checkout_action == 'shopify_cart' and prod != blank %}
        <form action="/cart/add" method="post" enctype="multipart/form-data">
          <input type="hidden" name="id" value="{{ prod.selected_or_first_available_variant.id }}">
          <button type="submit" class="btn-whatsapp btn-lg" id="pricing-order-btn">
            <svg class="wa-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            {{ section.settings.button_text | default: 'Add to Cart — $49' }}
          </button>
        </form>
      {% else %}
        <a href="https://wa.me/{{ settings.whatsapp_phone | default: 'YOUR_NUMBER_HERE' }}?text={{ settings.whatsapp_default_message | default: 'Hi! I want to order the DJ Crate Library 380GB for $49' | url_encode }}" target="_blank" rel="noopener" class="btn-whatsapp btn-lg" id="pricing-order-btn">
          <svg class="wa-icon" viewBox="0 0 24 24" fill="currentColor" width="22" height="22"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          {{ section.settings.button_text | default: 'Order on WhatsApp — Secure $49 Checkout' }}
        </a>
      {% endif %}

      <div class="cart-microcopy">
        <div class="microcopy-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>Official Buyer Protection Guaranteed</span>
        </div>
        <div class="microcopy-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
          <span>All Credit & Debit Cards Accepted</span>
        </div>
        <div class="microcopy-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span>Instant Lifetime Cloud Drive Access</span>
        </div>
      </div>

      <div class="payment-trust-strip">
        <div class="pay-trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>Buyer Protection</span>
        </div>
        <div class="pay-trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
          <span>All Cards</span>
        </div>
        <div class="pay-trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <span>256-Bit SSL</span>
        </div>
        <div class="pay-trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          <span>Instant Delivery</span>
        </div>
      </div>
      <p class="pricing-guarantee">⚡ Instant digital access link sent immediately after checkout</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pricing Section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "GET INSTANT ACCESS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One Purchase. Lifetime Library."
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "🔥 LIMITED TIME OFFER"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "DJ Crate Library — 380GB Complete Pack"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Get It Now — $49"
    }
  ],
  "presets": [
    {
      "name": "Pricing Section"
    }
  ]
}
{% endschema %}
