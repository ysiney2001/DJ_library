<section class="hero" id="hero">
  <div class="hero-inner">
    <div class="hero-text">
      <div class="hero-breadcrumb">{{ section.settings.eyebrow | default: 'THE ULTIMATE DJ CRATE PACK' }}</div>
      <h1>{{ section.settings.headline_part1 | default: 'DJ Crate Library' }}<br><span class="highlight">{{ section.settings.headline_highlight | default: '380GB of DJ Music' }}</span><br>{{ section.settings.headline_part2 | default: 'From the 70s to 2024' }}</h1>
      <ul class="hero-bullet-list">
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          <span>{{ section.settings.bullet_1 | default: 'Club-ready 320kbps tracks across 15+ genres' }}</span>
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          <span>{{ section.settings.bullet_2 | default: 'Lifetime Cloud access with zero storage panic' }}</span>
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          <span>{{ section.settings.bullet_3 | default: 'Download only the crates you need on demand' }}</span>
        </li>
      </ul>
      <p class="hero-subtext">{{ section.settings.pre_cta_text | default: 'Instant digital delivery via secure checkout.' }}</p>

      {% assign prod = all_products[settings.featured_product] %}
      {% if settings.primary_checkout_action == 'shopify_checkout' and prod != blank %}
        <a href="/cart/{{ prod.selected_or_first_available_variant.id }}:1?checkout" class="btn-whatsapp" id="hero-order-btn">
          <svg class="wa-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          {{ section.settings.button_text | default: 'Get It Now — $49' }}
        </a>
      {% elsif settings.primary_checkout_action == 'shopify_cart' and prod != blank %}
        <form action="/cart/add" method="post" enctype="multipart/form-data">
          <input type="hidden" name="id" value="{{ prod.selected_or_first_available_variant.id }}">
          <button type="submit" class="btn-whatsapp" id="hero-order-btn">
            <svg class="wa-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            {{ section.settings.button_text | default: 'Get It Now — $49' }}
          </button>
        </form>
      {% else %}
        <a href="https://wa.me/{{ settings.whatsapp_phone | default: 'YOUR_NUMBER_HERE' }}?text={{ settings.whatsapp_default_message | default: 'Hi! I want to order the DJ Crate Library 380GB for $49' | url_encode }}" target="_blank" rel="noopener" class="btn-whatsapp" id="hero-order-btn">
          <svg class="wa-icon" viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          {{ section.settings.button_text | default: 'Get It Now via WhatsApp — $49' }}
        </a>
      {% endif %}

      <div class="hero-trust">
        <div class="hero-trust-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span>Instant Download</span>
        </div>
        <div class="hero-trust-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span>15+ Genres</span>
        </div>
        <div class="hero-trust-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span>Club-Ready Quality</span>
        </div>
      </div>
    </div>
    <div class="hero-image">
      {% if section.settings.hero_image != blank %}
        <img src="{{ section.settings.hero_image | image_url: width: 600 }}" alt="{{ section.settings.headline_part1 }}" fetchpriority="high" id="product-box-img">
      {% else %}
        <img src="{{ 'product-box.png' | asset_url }}" alt="DJ Crate Library - 380GB Music Pack" fetchpriority="high" id="product-box-img">
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "THE ULTIMATE DJ CRATE PACK"
    },
    {
      "type": "text",
      "id": "headline_part1",
      "label": "Headline Line 1",
      "default": "DJ Crate Library"
    },
    {
      "type": "text",
      "id": "headline_highlight",
      "label": "Headline Highlighted Text",
      "default": "380GB of DJ Music"
    },
    {
      "type": "text",
      "id": "headline_part2",
      "label": "Headline Line 2",
      "default": "From the 70s to 2024"
    },
    {
      "type": "text",
      "id": "bullet_1",
      "label": "Bullet Point 1",
      "default": "Club-ready 320kbps tracks across 15+ genres"
    },
    {
      "type": "text",
      "id": "bullet_2",
      "label": "Bullet Point 2",
      "default": "Lifetime Cloud access with zero storage panic"
    },
    {
      "type": "text",
      "id": "bullet_3",
      "label": "Bullet Point 3",
      "default": "Download only the crates you need on demand"
    },
    {
      "type": "text",
      "id": "pre_cta_text",
      "label": "Pre-CTA Text",
      "default": "Instant digital delivery via secure checkout."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Get It Now — $49"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Product Image"
    }
  ],
  "presets": [
    {
      "name": "Hero Section"
    }
  ]
}
{% endschema %}
