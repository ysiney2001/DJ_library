<section class="dual-section" id="details">
  <div class="dual-inner">
    <div class="dual-card reveal">
      <h3>{{ section.settings.compat_title | default: 'COMPATIBILITY & FORMATS' }}</h3>
      <p class="dual-desc">{{ section.settings.compat_desc | default: 'Ready to import into any professional DJ software and storage device.' }}</p>
      <div class="compat-grid">
        <div class="compat-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m10 15 5-3-5-3v6z"/></svg>
          <span>Serato DJ</span>
        </div>
        <div class="compat-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          <span>Rekordbox</span>
        </div>
        <div class="compat-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
          <span>PC and Mac</span>
        </div>
        <div class="compat-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          <span>Traktor</span>
        </div>
        <div class="compat-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/></svg>
          <span>USB Drives</span>
        </div>
        <div class="compat-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
          <span>Virtual DJ</span>
        </div>
        <div class="compat-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
          <span>External Hard Drives</span>
        </div>
      </div>
      <p class="compat-note">DJ applications and hardware are not included.</p>
    </div>
    
    <div class="dual-card reveal">
      <h3>{{ section.settings.how_title | default: 'HOW TO BUY (3 SIMPLE STEPS)' }}</h3>
      <p class="dual-desc">{{ section.settings.how_desc | default: 'Fast, secure checkout with instant digital cloud access.' }}</p>
      <ol class="delivery-steps">
        <li>
          <span class="step-badge">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          </span>
          <span><strong>{{ section.settings.step1_title | default: 'Instant Checkout:' }}</strong> {{ section.settings.step1_desc | default: 'Click Buy Now to checkout securely via Shopify, PayPal, or Card.' }}</span>
        </li>
        <li>
          <span class="step-badge">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
          </span>
          <span><strong>{{ section.settings.step2_title | default: 'Pay Any Card:' }}</strong> {{ section.settings.step2_desc | default: 'Pay safely via Shop Pay, Apple Pay, PayPal, or any credit/debit card.' }}</span>
        </li>
        <li>
          <span class="step-badge">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </span>
          <span><strong>{{ section.settings.step3_title | default: 'Instant Access Link:' }}</strong> {{ section.settings.step3_desc | default: 'Receive your private 380GB Cloud Vault link immediately via email.' }}</span>
        </li>
      </ol>
      <div class="delivery-cloud-note">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span><strong>100% Protected Payment:</strong> Transactions are backed by encrypted checkout and 24/7 VIP redelivery support.</span>
      </div>
    </div>
  </div>
</section>

