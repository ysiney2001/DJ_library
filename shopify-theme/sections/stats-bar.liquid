<section class="stats-bar" id="stats">
  <div class="stats-inner">
    <div class="stat-item reveal">
      <div class="stat-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      </div>
      <div class="stat-text">
        <strong>{{ section.settings.stat1_value | default: '380GB+' }}</strong>
        <span>{{ section.settings.stat1_label | default: 'Music Files' }}</span>
      </div>
    </div>
    <div class="stat-item reveal">
      <div class="stat-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <div class="stat-text">
        <strong>{{ section.settings.stat2_value | default: '50+ Years' }}</strong>
        <span>{{ section.settings.stat2_label | default: '70s to 2024' }}</span>
      </div>
    </div>
    <div class="stat-item reveal">
      <div class="stat-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
      </div>
      <div class="stat-text">
        <strong>{{ section.settings.stat3_value | default: '15+' }}</strong>
        <span>{{ section.settings.stat3_label | default: 'Genres Covered' }}</span>
      </div>
    </div>
    <div class="stat-item reveal">
      <div class="stat-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
      </div>
      <div class="stat-text">
        <strong>{{ section.settings.stat4_value | default: '320kbps' }}</strong>
        <span>{{ section.settings.stat4_label | default: 'MP3 Quality' }}</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Stats Bar",
  "settings": [
    {
      "type": "text",
      "id": "stat1_value",
      "label": "Stat 1 Value",
      "default": "380GB+"
    },
    {
      "type": "text",
      "id": "stat1_label",
      "label": "Stat 1 Label",
      "default": "Music Files"
    },
    {
      "type": "text",
      "id": "stat2_value",
      "label": "Stat 2 Value",
      "default": "50+ Years"
    },
    {
      "type": "text",
      "id": "stat2_label",
      "label": "Stat 2 Label",
      "default": "70s to 2024"
    },
    {
      "type": "text",
      "id": "stat3_value",
      "label": "Stat 3 Value",
      "default": "15+"
    },
    {
      "type": "text",
      "id": "stat3_label",
      "label": "Stat 3 Label",
      "default": "Genres Covered"
    },
    {
      "type": "text",
      "id": "stat4_value",
      "label": "Stat 4 Value",
      "default": "320kbps"
    },
    {
      "type": "text",
      "id": "stat4_label",
      "label": "Stat 4 Label",
      "default": "MP3 Quality"
    }
  ],
  "presets": [
    {
      "name": "Stats Bar"
    }
  ]
}
{% endschema %}
