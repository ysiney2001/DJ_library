<section class="included" id="included">
  <div class="included-inner">
    <div class="included-image">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 600 }}" alt="{{ section.settings.heading }}" loading="lazy">
      {% else %}
        <img src="{{ 'laptop-library.png' | asset_url }}" alt="Organized DJ library on laptop" loading="lazy" width="520" height="390">
      {% endif %}
    </div>
    <div class="included-text">
      <p class="section-label">{{ section.settings.label | default: "WHAT'S INCLUDED" }}</p>
      <h2>{{ section.settings.heading | default: "Everything You Need in<br>One Organized Library" }}</h2>
      <ul class="dot-list">
        <li class="reveal">More than 380GB of music files.</li>
        <li class="reveal">Music spanning the 1970s through late 2024.</li>
        <li class="reveal">More than 15 organized music genres.</li>
        <li class="reveal">High-quality 320kbps MP3 files.</li>
        <li class="reveal">DJ-friendly intros, outros, remixes, and radio edits.</li>
        <li class="reveal">Clean and explicit versions where available.</li>
        <li class="reveal">Optional organized Serato crates.</li>
        <li class="reveal">Compatible with popular DJ workflows and external drives.</li>
      </ul>
      <div class="cloud-benefit-note reveal">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/><polyline points="12 13 12 17 12 17"/><polyline points="10 15 12 17 14 15"/></svg>
        <div>
          <strong>100% Lifetime Cloud Vault Included</strong><br>
          <span>No 380GB free space needed on your laptop. Browse in the cloud and download only the crates you need.</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "What's Included",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "WHAT'S INCLUDED"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everything You Need in<br>One Organized Library"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Included Section Image"
    }
  ],
  "presets": [
    {
      "name": "What's Included"
    }
  ]
}
{% endschema %}
